// import the shared library
@Library('jenkins-shared-library')

pipeline {
    agent any 

    // tools should be configured in JenkinsUI before we can use them here
    tools {
        maven 'maven-3.6'
    }

    stages {
        stage("build jar") {
            steps {
                script {
                    // name "buildJar" is defined in the shared library, we can call it directly here, its name of the function in the shared library
                    buildJar()
                }
            }
        }
    }

    stages {
        stage("build image") {
            steps {
                // call the groovy function with parameter of docker image name
                buildImage 'USERNAME_DOCKER/maven-test-app:3.0'
            }
        }
    }

    stages {
        stage("deploy") {
            steps {
                echo "deploying...."
            }
        }
    }
}