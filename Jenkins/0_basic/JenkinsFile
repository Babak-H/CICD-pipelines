// each jenkins file has a pipeline block, which is the main block of the jenkins file
pipeline {
    // agent defines where to execute the code, which server/executor, important for jenkins cluster
    agent {
        node {
            label 'docker-agent-python'
        }
    }
    // triggers defines when to execute the pipeline, here we set it to poll the source code management every minute, if there is any change, the pipeline will be triggered
    triggers {
        pollSCM '* * * * *'
    }
    // each pipeline includes several stages, each stage includes one or several steps, the steps is where do work happens, build, test, deploy,...
    stages {
        stage('Build') {
            steps {
                echo 'bulding the python app...'
                sh'''
                cd myapp
                pip install -r requirements.txt
                '''
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
                sh'''
                cd myapp
                python3 hello.py
                python3 hello.py --name=Babak
                '''
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deliver...'
                sh'''
                echo 'deploying the app to the kubernetes cluster...'
                '''
            }
        }
    }
}