
pipeline {
    agent any 
    tools {
        maven 'maven-3.6'
    }
    environment {
        EC2_INSTANCE = 'ec2-user@3.122.239.45'
        REMOTE_DEPLOY_DIR = '/home/ec2-user/demo-app'
    }

    stages {
        stage("test") {
            steps {
                script {
                    echo "testing the app..."
                    // this image name can change based on version incrementation
                    env.IMAGE_NAME = "DOCKER_USERNAME/demo-app:java-maven-1.0"
                }
            }
        }
    
        stage("build") {
            steps {
                script {
                    echo "building the app..."
                } 
            }
        }

        stage("deploy") {
            steps {
                script {
                    echo "deploying image to EC2..."
                    // Note: This assumes the EC2 instance has Docker installed and the Jenkins server has SSH access to it using the 'ec2-server-key' credentials
                    sshagent(['ec2-server-key']) {
                        sh '''
                            set -euo pipefail

                            ssh -o StrictHostKeyChecking=accept-new "${EC2_INSTANCE}" "mkdir -p '${REMOTE_DEPLOY_DIR}'"

                            scp -o StrictHostKeyChecking=accept-new \
                              Jenkins/6_jenkins_aws/server-cmds.sh \
                              Jenkins/6_jenkins_aws/docker-compose.yml \
                              "${EC2_INSTANCE}:${REMOTE_DEPLOY_DIR}/"

                            ssh -o StrictHostKeyChecking=accept-new "${EC2_INSTANCE}" \
                              "cd '${REMOTE_DEPLOY_DIR}' && bash ./server-cmds.sh '${IMAGE_NAME}'"
                        '''
                    }
                }
            }
        }
    }
}
