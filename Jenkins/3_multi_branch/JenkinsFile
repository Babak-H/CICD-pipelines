/// multi-branch pipeline

pipeline {
    // we don't specify the agent at the top level, because we want to run different stages on different agents
    agent none
    stages {

        stage('test') {
            steps {
                script {
                    echo "Testing..."
                    echo "testing the pipeline $BRANCH_NAME"
                }
            }
        }

        stage('build') {
            when {
                // BRANCH_NAME is a built-in variable in Jenkins that contains the name of the branch being built
                expression {
                    BRANCH_NAME == 'master'
                }
            }
            steps {
                script {
                    echo "Building..."
                }
            }
        }

        stage('deploy') {
            when {
                expression {
                    BRANCH_NAME == 'master'
                }
            }
            steps {
                script {
                    echo "Deploying..."
                }
            }
        }
    }
}
